# Seed the OatLabs 1Password items -- local, staging, production -- with
# REPLACE_ME placeholders for every field the entrypoints read. Safe to rerun.
seed-vault:
    ./scripts/seed-vault.sh

# Bootstrap the flux entrypoint at clusters/entrypoints/<env>/<cluster>, e.g.
#   just bootstrap staging/us-west-2-aws-backoffice-dataplane
# Omit the target to pick one interactively.
bootstrap target="":
    ./scripts/bootstrap.sh {{ target }}

# Tear the same <env>/<cluster> target down, ahead of terraform destroy.
destroy target="":
    ./scripts/destroy.sh {{ target }}

psql db="postgres-chain-indexer" user="hasura" dbname="indexer-db" zone="us-west-2-aws-backoffice.oatlabs-staging.oatmilk.work":
    @PGPASSWORD="${PGPASSWORD:-pass123}" \
    psql "host={{ db }}.{{ zone }} port=5432 user={{ user }} dbname={{ dbname }} sslmode=verify-full sslrootcert=tests/stg-root-x1.pem"
