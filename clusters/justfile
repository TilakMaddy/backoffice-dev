# Seed the 1Password items -- local, staging, production -- with REPLACE_ME
# placeholders for every field the entrypoints read, and with the backup
# destination and region read from terraform. Safe to rerun. Name one env, e.g.
#   just seed-vault staging
# to leave the others alone.
seed-vault env="":
    ./scripts/seed-vault.sh {{ env }}

# Bootstrap the flux entrypoint at clusters/entrypoints/<env>/<cluster>, e.g.
#   just bootstrap staging/us-west-2-aws-backoffice-dataplane
# Omit the target to pick one interactively.
bootstrap target="":
    ./scripts/bootstrap.sh {{ target }}

# Tear the same <env>/<cluster> target down, ahead of terraform destroy.
destroy target="":
    ./scripts/destroy.sh {{ target }}

psql env="staging" db="postgres-chain-indexer" dbname="indexer-db" zone="us-west-2-aws-backoffice.oatlabs-staging.oatmilk.work":
    @PGPASSWORD="${PGPASSWORD:-$(op read 'op://MyIndexer/{{ env }}/chain-indexer-pg-superuser-password')}" \
    psql "host={{ db }}.{{ zone }} port=5432 user=postgres dbname={{ dbname }} sslmode=verify-full sslrootcert=tests/stg-root-x1.pem"
