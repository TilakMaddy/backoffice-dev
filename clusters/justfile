# Seed the 1Password items -- local, staging, production -- with REPLACE_ME
# placeholders for every field the entrypoints read, and with the backup
# destination and region read from terraform. Safe to rerun. Name one env, e.g.
#   just seed-vault staging
# to leave the others alone.
seed-vault env="":
    ./scripts/seed-vault.sh {{ env }}

# Bootstrap the flux entrypoint at clusters/entrypoints/<env>/<cluster>, e.g.
#   just bootstrap staging/us-west-2-aws-backoffice-dataplane
# Omit the target to pick one interactively.
bootstrap target="":
    ./scripts/bootstrap.sh {{ target }}

# Tear the same <env>/<cluster> target down, ahead of terraform destroy.
destroy target="":
    ./scripts/destroy.sh {{ target }}

stg_zone := "us-west-2-aws-backoffice.oatlabs-staging.oatmilk.work"

psql-staging:
    @PGPASSWORD="${PGPASSWORD:-$(op read 'op://MyIndexer/staging/chain-indexer-pg-superuser-password')}" \
    psql "host=postgres-chain-indexer.{{ stg_zone }} port=5432 user=postgres dbname=indexer-db sslmode=verify-full sslrootcert=tests/stg-root-x1.pem"

hasura-staging query="{ chain_metadata { chain_id start_block block_height latest_processed_block num_events_processed is_hyper_sync } }":
    @q={{ quote(query) }}; if [ ! -t 0 ]; then s="$(cat)"; if [ -n "$s" ]; then q="$s"; fi; fi; \
    jq -nc --arg q "$q" '{query:$q}' \
    | curl -sS --cacert tests/stg-root-x1.pem -d @- \
        -H "x-hasura-admin-secret: ${HASURA_ADMIN_SECRET:-$(op read 'op://MyIndexer/staging/chain-indexer-hasura-admin-secret')}" \
        -H 'Content-Type: application/json' \
        "https://hasura-chain-indexer.{{ stg_zone }}/v1/graphql" \
    | jq .

grafana-staging:
    @op read 'op://MyIndexer/staging/grafana-admin-password' | tr -d '\n' | pbcopy
    @echo "user $(op read 'op://MyIndexer/staging/grafana-admin-username') -- password copied to clipboard"
    @open "https://grafana.{{ stg_zone }}"
