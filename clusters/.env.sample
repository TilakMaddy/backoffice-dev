# shellcheck disable=SC2034

###################### Secrets ###########################

# For fluxcd
GITHUB_TOKEN=

# For platform
OP_SERVICE_ACCOUNT_TOKEN=

##################### Config ##############################

# Nothing is required here. `just bootstrap <env>/<cluster>` derives the
# kubeconfig from the target:
#
#   <env>/<cluster>  ->  infra/<env>/.kube/<cluster>.config
#   local/<cluster>  ->  ~/.kube/config
#
# Set KUBECONFIG_PATH_<env>_<cluster> -- every '-' written as '_' -- to point a
# single target somewhere else instead.
#
# KUBECONFIG_PATH_staging_us_west_2_aws_backoffice_dataplane=/path/to/.kube/config
